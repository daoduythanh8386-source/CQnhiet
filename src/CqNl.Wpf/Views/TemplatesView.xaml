<UserControl x:Class="CqNl.Wpf.Views.TemplatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Template CQ" Style="{StaticResource H1}"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
      <WrapPanel>
        <Button Style="{StaticResource Primary}" Click="Add_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Thêm template mới…"/></StackPanel>
        </Button>
        <Button Content="Sửa bản đồ ô…" Click="Edit_Click"/>
        <Button Content="Xem thử (PDF)" Click="Preview_Click"/>
        <Button x:Name="ResetBtn" Content="Khôi phục bản đồ mặc định" Click="Reset_Click"/>
        <Button x:Name="RemoveBtn" Content="Ngừng dùng" Style="{StaticResource Danger}" Click="Remove_Click"/>
        <Button Click="Refresh_Click" ToolTip="Làm mới"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"/></Button>
      </WrapPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,10,0,0"
               Text="Template mặc định (Thép carbon, Thép khuôn dập, Thép gió) dùng file Excel GỐC cài kèm — không sửa, không xoá file; chỉ sửa được bản đồ ô (có Khôi phục mặc định). Template thêm mới lưu trong kho chung nên mọi máy đều dùng được. Khi thêm: chọn file Excel → ứng dụng TỰ DÒ vị trí ô theo một template có sẵn (điền sẵn), hoặc tự nhập tay từng ô → kiểm tra → xem thử PDF → lưu. CQ đã tạo luôn giữ đúng bản đồ lúc tạo."/>
    <Border Style="{StaticResource Card}" Padding="0">
      <DataGrid x:Name="Grid" MouseDoubleClick="Edit_Click" SelectionChanged="Grid_SelectionChanged" BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tên template" Binding="{Binding DisplayName}" Width="220"/>
          <DataGridTextColumn Header="Loại" Binding="{Binding KindText}" Width="190"/>
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="170"/>
          <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="*"/>
          <DataGridTextColumn Header="Tình trạng" Binding="{Binding Status}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
