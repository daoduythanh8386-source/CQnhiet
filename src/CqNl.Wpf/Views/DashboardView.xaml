<UserControl x:Class="CqNl.Wpf.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Width" Value="178"/><Setter Property="Height" Value="100"/><Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
              <Grid>
                <Border Width="5" HorizontalAlignment="Left" CornerRadius="14,0,0,14" Background="{TemplateBinding BorderBrush}"/>
                <ContentPresenter Margin="16,10,12,10"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Effect" Value="{StaticResource PrimaryGlow}"/><Setter TargetName="b" Property="RenderTransform" Value="{StaticResource LiftUp}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform" Value="{StaticResource PressDown}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Làm mới" Click="Refresh_Click"/>
        <Button x:Name="ExportBtn" Content="Xuất báo cáo Excel…" Style="{StaticResource Primary}" Click="Export_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Tổng quan" Style="{StaticResource H1}" Margin="0,0,16,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="PeriodBox" Width="150" SelectionChanged="Period_Changed">
          <ComboBoxItem Content="Tháng này"/><ComboBoxItem Content="Tháng trước"/><ComboBoxItem Content="3 tháng gần đây"/>
          <ComboBoxItem Content="Năm nay"/><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Tùy chọn"/>
        </ComboBox>
        <TextBlock Text="Từ" VerticalAlignment="Center" Margin="10,0,4,0"/><DatePicker x:Name="FromBox" Width="125" SelectedDateChanged="Date_Changed"/>
        <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0,4,0"/><DatePicker x:Name="ToBox" Width="125" SelectedDateChanged="Date_Changed"/>
        <TextBox x:Name="CustomerBox" Width="220" Margin="10,0,0,0" ToolTip="Lọc theo khách hàng" TextChanged="Customer_Changed"/>
        <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Theo ngày nhận đơn. Bấm vào ô để xem danh sách đơn tương ứng." Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        <WrapPanel x:Name="Tiles"/>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Theo tháng nhận đơn" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ItemsControl x:Name="MonthBars"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Rectangle Width="12" Height="12" Fill="{StaticResource OkBrush}"/><TextBlock Text=" Đạt   " FontSize="11.5"/>
                <Rectangle Width="12" Height="12" Fill="{StaticResource BadBrush}"/><TextBlock Text=" Không đạt   " FontSize="11.5"/>
                <Rectangle Width="12" Height="12" Fill="#C9D2DE"/><TextBlock Text=" Chưa có kết quả" FontSize="11.5"/>
              </StackPanel>
              <DataGrid x:Name="MonthGrid" Margin="0,10,0,0" MaxHeight="300">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Tháng" Binding="{Binding Name}" Width="80"/>
                  <DataGridTextColumn Header="Tổng" Binding="{Binding Total}" Width="55"/>
                  <DataGridTextColumn Header="Đạt" Binding="{Binding Pass}" Width="50"/>
                  <DataGridTextColumn Header="K.đạt" Binding="{Binding Fail}" Width="50"/>
                  <DataGridTextColumn Header="Tỉ lệ đạt" Binding="{Binding PassRate}" Width="70"/>
                  <DataGridTextColumn Header="Đã làm CQ" Binding="{Binding WithCq}" Width="80"/>
                  <DataGridTextColumn Header="Chưa làm" Binding="{Binding WithoutCq}" Width="70"/>
                  <DataGridTextColumn Header="Đã in" Binding="{Binding Printed}" Width="55"/>
                  <DataGridTextColumn Header="Chưa in" Binding="{Binding NotPrinted}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Theo khách hàng (nhiều đơn nhất)" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <DataGrid x:Name="CustomerGrid" MaxHeight="430" MouseDoubleClick="CustomerGrid_DoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Khách hàng" Binding="{Binding Name}" Width="*"/>
                  <DataGridTextColumn Header="Tổng" Binding="{Binding Total}" Width="50"/>
                  <DataGridTextColumn Header="Đạt" Binding="{Binding Pass}" Width="45"/>
                  <DataGridTextColumn Header="K.đạt" Binding="{Binding Fail}" Width="48"/>
                  <DataGridTextColumn Header="Tỉ lệ" Binding="{Binding PassRate}" Width="55"/>
                  <DataGridTextColumn Header="Chưa làm CQ" Binding="{Binding WithoutCq}" Width="85"/>
                  <DataGridTextColumn Header="Chưa in" Binding="{Binding NotPrinted}" Width="60"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock x:Name="ListTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="LineGrid" Height="360" MouseDoubleClick="Line_DoubleClick" PreviewKeyDown="Line_KeyDown">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Số ĐNGC" Binding="{Binding Dngc}" Width="160"/>
                <DataGridTextColumn Header="Dòng" Binding="{Binding Line}" Width="60"/>
                <DataGridTextColumn Header="Ngày nhận" Binding="{Binding ReceivedText}" Width="85"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}" Width="2*"/>
                <DataGridTextColumn Header="Mác" Binding="{Binding Grade}" Width="70"/>
                <DataGridTextColumn Header="CQ" Binding="{Binding CqStatus}" Width="95"/>
                <DataGridTextColumn Header="Số BC" Binding="{Binding ReportNo}" Width="65"/>
                <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="105"/>
                <DataGridTextColumn Header="In" Binding="{Binding PrintStatus}" Width="65"/>
                <DataGridTextColumn Header="Lưu ý" Binding="{Binding Notes}" Width="50"/>
                <DataGridTextColumn Header="Cảnh báo" Binding="{Binding Flags}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
