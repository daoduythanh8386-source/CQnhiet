<UserControl x:Class="CqNl.Wpf.Views.AccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:CqNl.Wpf.Views">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Tài khoản &amp; phiên đăng nhập" Style="{StaticResource H1}"/>
    <TabControl>
      <TabItem Header="Tài khoản"><v:UsersView Margin="0,6,0,0"/></TabItem>
      <TabItem Header="Đang online"><v:OnlineView Margin="0,6,0,0"/></TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
