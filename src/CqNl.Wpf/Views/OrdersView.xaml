<UserControl x:Class="CqNl.Wpf.Views.OrdersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <!-- Tiêu đề + 1 nút ERP (nhập tự động đã chạy nền 2 phút/lần) -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button x:Name="ErpBtn" DockPanel.Dock="Right" Click="Erp_Click" Margin="0" VerticalAlignment="Center"
              ToolTip="App tự nhập file ERP mới mỗi 2 phút. Nút này để nhập ngay hoặc chọn một file ERP lẻ.">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Nhập ERP ▾"/></StackPanel>
      </Button>
      <TextBlock Text="Đơn gia công" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center"/>
      <TextBlock x:Name="ErpStatusText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,4,0,0" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <!-- bộ lọc theo bước làm việc -->
    <WrapPanel x:Name="Chips" DockPanel.Dock="Top" Margin="0,0,0,10"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
      <DockPanel>
        <Button x:Name="ColumnsBtn" DockPanel.Dock="Right" Click="Columns_Click" Margin="0" ToolTip="Chọn cột hiển thị (nhớ theo máy)"/>
        <StackPanel Orientation="Horizontal">
          <Grid Width="300">
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,5,8,5"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Tìm số ĐNGC, khách hàng, mác, số CQ…" Foreground="#9AA5B4" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <ComboBox x:Name="CustomerPick" Width="240" Margin="8,0,0,0" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                    DisplayMemberPath="Text" SelectionChanged="CustomerPick_Changed" ToolTip="Chỉ hiện đơn của một khách hàng (gõ vài chữ đầu để tìm)"/>
          <ComboBox x:Name="DaysPick" Width="150" Margin="8,0,0,0" SelectionChanged="DaysPick_Changed" ToolTip="Chỉ hiện đơn nhận trong khoảng này (đơn không có ngày nhận luôn hiện)">
            <ComboBoxItem Content="Nhận 7 ngày qua" Tag="7"/><ComboBoxItem Content="Nhận 30 ngày qua" Tag="30"/>
            <ComboBoxItem Content="Nhận 90 ngày qua" Tag="90"/><ComboBoxItem Content="Mọi ngày nhận" Tag="0"/>
          </ComboBox>
          <Button x:Name="ClearBtn" Content="✕ Xoá bộ lọc" Click="Clear_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"
               Text="Màu dòng: xanh = đã in CQ · vàng = CQ nháp chưa duyệt · trắng = chưa in  ·  Nháy đúp để mở đơn · chuột phải: gộp / tách · F5: đọc lại kho · ✎ lưu ý · ⚠ cảnh báo ERP · ⧉ gộp chung CQ"/>
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <DataGrid x:Name="Grid" MouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown" SelectionMode="Extended" BorderThickness="0"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserSortColumns="True" CanUserReorderColumns="True">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding RowColor}" Value="printed"><Setter Property="Background" Value="#A9D08E"/></DataTrigger>
                <DataTrigger Binding="{Binding RowColor}" Value="draft"><Setter Property="Background" Value="#FFE699"/></DataTrigger>
                <DataTrigger Binding="{Binding IsChild}" Value="True"><Setter Property="Foreground" Value="#5E6672"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Mở đơn" Click="Open_Click" InputGestureText="Enter"/>
              <Separator/>
              <MenuItem x:Name="MergeMenu" Header="Gộp các dòng đã chọn thành một CQ" Click="Merge_Click"/>
              <MenuItem x:Name="SplitMenu" Header="Tách nhóm gộp" Click="Split_Click"/>
              <Separator/>
              <MenuItem Header="Đọc lại toàn bộ kho" Click="Refresh_Click" InputGestureText="F5"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextAlignment="Center" Visibility="Collapsed"/>
        <Popup x:Name="FilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
          <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Width="290" Margin="8">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/></Border.Effect>
            <StackPanel>
              <TextBlock x:Name="FilterTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="FilterSearch" TextChanged="FilterSearch_Changed"/>
              <CheckBox x:Name="FilterAll" Content="(Chọn tất cả)" Margin="2,8,0,4" Click="FilterAll_Click"/>
              <ListBox x:Name="FilterList" Height="240" BorderBrush="{StaticResource Line}">
                <ListBox.ItemTemplate>
                  <DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding On, Mode=TwoWay}"/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Bỏ lọc cột" Click="FilterClear_Click"/>
                <Button Content="Lọc" Style="{StaticResource Primary}" Click="FilterOk_Click" Margin="0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
