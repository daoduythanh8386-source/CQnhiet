<Window x:Class="CqNl.Wpf.Views.PickGradeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chọn dòng bảng mác" Width="900" Height="360" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Mác này có nhiều dòng KHÁC thông số trong bảng mác. Ứng dụng không tự chọn — hãy chọn đúng dòng theo đơn."/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Chọn dòng này" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Hủy" IsCancel="True" Margin="0"/>
    </StackPanel>
    <DataGrid x:Name="Grid" MouseDoubleClick="Ok_Click">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Dòng" Binding="{Binding SourceRow}" Width="50"/>
        <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="120"/>
        <DataGridTextColumn Header="Mác" Binding="{Binding Name}" Width="90"/>
        <DataGridTextColumn Header="Gia nhiệt" Binding="{Binding HeatText}" Width="*"/>
        <DataGridTextColumn Header="Ram" Binding="{Binding RamText}" Width="*"/>
        <DataGridTextColumn Header="Dung sai" Binding="{Binding Tolerance}" Width="110"/>
        <DataGridTextColumn Header="Đánh dấu" Binding="{Binding TemplateMark}" Width="70"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
