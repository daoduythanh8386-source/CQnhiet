<Window x:Class="CqNl.Wpf.Views.TemplateEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Template CQ" Width="1180" Height="820" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Page}">
  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" x:Name="Head" Style="{StaticResource H1}"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Tên template" Style="{StaticResource Label}" Margin="0,0,0,3"/>
          <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Sheet chứa biểu mẫu" Style="{StaticResource Label}" Margin="0,0,0,3"/>
          <ComboBox x:Name="SheetBox" SelectionChanged="Sheet_Changed"/>
        </StackPanel>
        <StackPanel Grid.Column="4" x:Name="AutoPanel">
          <TextBlock Text="Cách lập bản đồ ô" Style="{StaticResource Label}" Margin="0,0,0,3"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Tự dò theo mẫu:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="BaseBox" Width="190" DisplayMemberPath="DisplayName"/>
            <Button Content="Tự dò (điền sẵn)" Style="{StaticResource Primary}" Click="Auto_Click" Margin="8,0,6,0"/>
            <Button Content="Làm tay (trống)" Click="Manual_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"/>
      <Button Content="Kiểm tra" Click="Check_Click"/>
      <Button Content="Xem thử PDF" Click="Preview_Click"/>
      <Button Content="Lưu template" Style="{StaticResource Primary}" Click="Save_Click"/>
      <Button Content="Đóng" IsCancel="True" Margin="0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12" MaxHeight="150">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Report" TextWrapping="Wrap" FontSize="12"/></ScrollViewer>
    </Border>
    <Border Style="{StaticResource Card}" Padding="0">
      <DataGrid x:Name="Fields" RowHeight="NaN" MinRowHeight="30" IsReadOnly="False" BorderThickness="0" CellEditEnding="Fields_CellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Trường trên CQ" Binding="{Binding Label}" Width="230" IsReadOnly="True"/>
          <DataGridTextColumn Header="Ô / vùng ô (sửa được)" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
          <DataGridTextColumn Header="Gợi ý" Binding="{Binding Hint}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="Nội dung ô trong file / nhãn" Binding="{Binding CellText}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="Kiểm tra" Binding="{Binding Check}" Width="240" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
