<UserControl x:Class="CqNl.Wpf.Views.CqHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Lịch sử CQ" Style="{StaticResource H1}"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Mở đơn" Click="OpenOrder_Click"/>
        <Button Content="Mở PDF" Click="OpenPdf_Click"/>
        <Button Content="Làm mới" Click="Refresh_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="SearchBox" Width="280" TextChanged="Filter_Changed" ToolTip="Tìm theo số báo cáo, số ĐNGC, người tạo"/>
        <ComboBox x:Name="StateBox" Width="170" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã duyệt"/><ComboBoxItem Content="Đã duyệt, chưa in"/><ComboBoxItem Content="Đã xóa"/>
        </ComboBox>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>
    <DataGrid x:Name="Grid" MouseDoubleClick="OpenOrder_Click">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Số báo cáo" Binding="{Binding ReportNo}" Width="90"/>
        <DataGridTextColumn Header="Đơn" Binding="{Binding OrderKey}" Width="250"/>
        <DataGridTextColumn Header="Bản" Binding="{Binding Ver}" Width="45"/>
        <DataGridTextColumn Header="Template" Binding="{Binding TemplateId}" Width="90"/>
        <DataGridTextColumn Header="Kết quả" Binding="{Binding ResultText}" Width="85"/>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StateText}" Width="100"/>
        <DataGridTextColumn Header="Tạo" Binding="{Binding Created}" Width="180"/>
        <DataGridTextColumn Header="Duyệt" Binding="{Binding Approved}" Width="180"/>
        <DataGridTextColumn Header="In" Binding="{Binding Printed}" Width="160"/>
        <DataGridTextColumn Header="Xóa / cảnh báo" Binding="{Binding Notes}" Width="*" MinWidth="120"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
