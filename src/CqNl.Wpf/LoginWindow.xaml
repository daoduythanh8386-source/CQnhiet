<Window x:Class="CqNl.Wpf.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CQ Nhiệt Luyện — Đăng nhập" Icon="pack://application:,,,/CQNhietLuyen;component/Assets/app.ico" Width="920" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="{StaticResource Page}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White">
      <TextBlock x:Name="FooterText" Style="{StaticResource Footer}" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6"/>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarBrush}">
        <StackPanel VerticalAlignment="Center" Margin="34,30">
          <Border Background="White" CornerRadius="16" Padding="18,16">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#4DA3FF"/></Border.Effect>
            <Image Source="pack://application:,,,/CQNhietLuyen;component/Assets/logo_wide.png" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="CQ NHIỆT LUYỆN" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,24,0,4" HorizontalAlignment="Center"/>
          <TextBlock Text="Phiếu kiểm tra chất lượng nhiệt luyện" Foreground="#9DB8E8" HorizontalAlignment="Center"/>
          <TextBlock Text="Đơn gia công · Kết quả đo · CQ · Báo cáo" Foreground="#6F8BB5" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock x:Name="VersionText" Foreground="#6F8BB5" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Margin="40,34" VerticalAlignment="Center">
        <TextBlock Text="Đăng nhập" Style="{StaticResource H1}"/>
        <Border x:Name="StatusBox" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StorePathText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      <StackPanel x:Name="LoginPanel">
        <TextBlock Text="Tên đăng nhập" Style="{StaticResource Label}"/>
        <TextBox x:Name="UserBox"/>
        <TextBlock Text="Mật khẩu" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="PassBox"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="LoginBtn" Content="Đăng nhập" Style="{StaticResource Primary}" IsDefault="True" Click="Login_Click" MinWidth="120"/>
          <Button Content="Kiểm tra lại kho" Click="Retry_Click"/>
          <Button Content="Đổi đường dẫn kho…" Click="ChangeStore_Click"/>
        </StackPanel>
        <TextBlock Margin="2,12,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}"
                   Text="Quên mật khẩu: liên hệ quản trị (admin) để được đặt lại. Nhập sai 5 lần liên tiếp, tài khoản tạm khoá 15 phút."/>
        <Border Background="#F2F6FC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
          <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"
                     Text="Chưa có tài khoản? Vui lòng liên hệ quản trị (admin) để được hỗ trợ tạo tài khoản. Ứng dụng không tự tạo tài khoản khi cài đặt — mọi máy dùng chung tài khoản trên kho dữ liệu chung."/>
        </Border>
        <Button x:Name="InitBtn" Visibility="Collapsed" Content="Khởi tạo quản trị cho kho mới…" Click="Init_Click" HorizontalAlignment="Left" Margin="0,10,0,0"
                ToolTip="Chỉ hiện trên máy chứa kho chung khi kho chưa có tài khoản nào"/>
      </StackPanel>

      <StackPanel x:Name="FirstAdminPanel" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="KHỞI TẠO KHO MỚI — chỉ làm MỘT LẦN trên máy chứa kho chung. Tạo tài khoản quản trị đầu tiên (mật khẩu do bạn tự đặt, tối thiểu 6 ký tự). Sau đó quản trị tạo tài khoản cho từng người trong mục Tài khoản &amp; phiên."/>
        <TextBlock Text="Tên đăng nhập" Style="{StaticResource Label}"/>
        <TextBox x:Name="NewUserBox" Text="admin"/>
        <TextBlock Text="Họ tên" Style="{StaticResource Label}"/>
        <TextBox x:Name="NewNameBox"/>
        <TextBlock Text="Mật khẩu" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="NewPassBox"/>
        <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="NewPass2Box"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Tạo tài khoản quản trị" Style="{StaticResource Primary}" Click="CreateAdmin_Click"/>
          <Button Content="Huỷ" Click="CancelInit_Click"/>
        </StackPanel>
      </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
