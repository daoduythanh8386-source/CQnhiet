<Window x:Class="CqNl.Wpf.ChangePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Đổi mật khẩu" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock x:Name="Note" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource Label}"/>
    <PasswordBox x:Name="OldBox"/>
    <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự, khác mật khẩu mặc định)" Style="{StaticResource Label}"/>
    <PasswordBox x:Name="NewBox"/>
    <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource Label}"/>
    <PasswordBox x:Name="ConfirmBox"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Đổi mật khẩu" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Hủy" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
