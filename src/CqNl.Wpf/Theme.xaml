<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <!-- ===================== Bảng màu (giao diện "studio": nền sáng, thanh bên xanh đậm, điểm nhấn xanh ORISTAR) ===================== -->
  <Color x:Key="AccentColor">#1F5FD0</Color>
  <Color x:Key="GlowColor">#4DA3FF</Color>
  <SolidColorBrush x:Key="Accent" Color="#1F5FD0"/>
  <SolidColorBrush x:Key="AccentDark" Color="#15469E"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
  <SolidColorBrush x:Key="BrandRed" Color="#E3241B"/>
  <SolidColorBrush x:Key="Line" Color="#DCE3EC"/>
  <SolidColorBrush x:Key="Muted" Color="#5B6675"/>
  <SolidColorBrush x:Key="Panel" Color="#F2F5FA"/>
  <SolidColorBrush x:Key="Page" Color="#EEF2F8"/>
  <SolidColorBrush x:Key="Ink" Color="#1B2330"/>
  <SolidColorBrush x:Key="OkBrush" Color="#1E7D32"/>
  <SolidColorBrush x:Key="BadBrush" Color="#C62828"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#9A6700"/>
  <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0F1E3A" Offset="0"/><GradientStop Color="#132A52" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3A7BEA" Offset="0"/><GradientStop Color="#1F5FD0" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.10" Color="#0B1B3A"/>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#0B1B3A"/>
  <TranslateTransform x:Key="PressDown" Y="1"/>
  <TranslateTransform x:Key="LiftUp" Y="-1"/>
  <DropShadowEffect x:Key="PrimaryShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.30" Color="#1F5FD0"/>
  <DropShadowEffect x:Key="PrimaryGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#4DA3FF"/>
  <DropShadowEffect x:Key="NavShadow" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000814"/>
  <DropShadowEffect x:Key="NavGlowHover" BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#4DA3FF"/>
  <DropShadowEffect x:Key="NavGlowChecked" BlurRadius="22" ShadowDepth="0" Opacity="0.85" Color="#4DA3FF"/>
  <DropShadowEffect x:Key="ChipShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#0B1B3A"/>
  <DropShadowEffect x:Key="ChipGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#4DA3FF"/>
  <LinearGradientBrush x:Key="NavBg" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1E3B69" Offset="0"/><GradientStop Color="#162D52" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="NavBgHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2C5694" Offset="0"/><GradientStop Color="#20447C" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="NavBgChecked" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4A90FF" Offset="0"/><GradientStop Color="#1F5FD0" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="NavBorder" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3E6299" Offset="0"/><GradientStop Color="#0C1A33" Offset="1"/></LinearGradientBrush>
  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12.5"/></Style>
  <Style TargetType="UserControl"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12.5"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#1B2330"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/></Style>

  <!-- ===================== Nút ===================== -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="28"/>
    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}" Effect="{StaticResource SoftShadow}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="b" Property="Background" Value="#F5F9FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="RenderTransform" Value="{StaticResource PressDown}"/><Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  Effect="{StaticResource PrimaryShadow}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#3D86FF"/>
              <Setter TargetName="b" Property="Effect" Value="{StaticResource PrimaryGlow}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform" Value="{StaticResource PressDown}"/><Setter TargetName="b" Property="Background" Value="#174FB5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="6,2"/><Setter Property="MinHeight" Value="22"/><Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="11"/>
  </Style>

  <!-- ===================== Mục menu 3D: nổi khối, rê chuột sáng lên, chọn thì phát sáng ===================== -->
  <Style x:Key="Nav" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#D6E2F5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Margin="10,2" Padding="10,7" CornerRadius="9" BorderThickness="1" Background="{StaticResource NavBg}"
                  BorderBrush="{StaticResource NavBorder}" Effect="{StaticResource NavShadow}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="14" Width="24" VerticalAlignment="Center" Foreground="#8FB3E8"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource NavBgHover}"/><Setter TargetName="b" Property="Effect" Value="{StaticResource NavGlowHover}"/>
              <Setter TargetName="b" Property="RenderTransform" Value="{StaticResource LiftUp}"/><Setter TargetName="ic" Property="Foreground" Value="White"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource NavBgChecked}"/><Setter TargetName="b" Property="Effect" Value="{StaticResource NavGlowChecked}"/>
              <Setter TargetName="ic" Property="Foreground" Value="White"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform" Value="{StaticResource PressDown}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chip lọc trạng thái (Tất cả, Đã có CQ, Chưa làm…) -->
  <Style x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="11,4" Effect="{StaticResource ChipShadow}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDark}"/>
              <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="b" Property="Effect" Value="{StaticResource ChipGlow}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thẻ (card) nền trắng bo góc đổ bóng -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/>
    <Setter Property="BorderBrush" Value="#E3E9F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/>
  </Style>

  <!-- ===================== Ô nhập ===================== -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="6,3"/><Setter Property="MinHeight" Value="28"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#9DB8E8"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="b" Property="BorderThickness" Value="1.6"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#F3F5F8"/><Setter Property="Foreground" Value="#6B7684"/></Trigger>
            <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="b" Property="Background" Value="#F7F9FC"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="6,3"/><Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="b" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="b" Property="BorderThickness" Value="1.6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style TargetType="DatePicker"><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>

  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,6,0,2"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Footer" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#3A4656"/><Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,5"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E3E9F2" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <StackPanel>
              <ContentPresenter ContentSource="Header" TextBlock.FontSize="15" TextBlock.FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ContentPresenter/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Tab dạng thẻ nổi ===================== -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,8,0,0"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="b" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Effect="{StaticResource ChipShadow}">
            <ContentPresenter x:Name="cp" ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            <!-- chỉ đổi màu chữ TIÊU ĐỀ tab: đặt Foreground lên TabItem sẽ lan xuống cả NỘI DUNG tab (chữ trắng trên nền sáng — lỗi v23–v31) -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/><Setter TargetName="cp" Property="TextElement.FontWeight" Value="SemiBold"/>
              <Setter TargetName="b" Property="Effect" Value="{StaticResource ChipGlow}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Bảng dữ liệu ===================== -->
  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/><Setter Property="RowHeight" Value="26"/><Setter Property="BorderBrush" Value="#E3E9F2"/>
    <Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/>
    <Setter Property="CanUserAddRows" Value="False"/><Setter Property="AlternatingRowBackground" Value="#FAFCFF"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F4F7FC"/><Setter Property="Foreground" Value="#2B3645"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="6,5"/><Setter Property="BorderBrush" Value="#E3E9F2"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style TargetType="DataGridRow">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4FF"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="6,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D7E6FF"/><Setter Property="Foreground" Value="#0E2A5C"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
